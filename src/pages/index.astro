---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL;
---

<Layout title="Pet Forest - Menu Utama">
    <div class="page-content center-content">
        <h1 class="game-title">Pet Forest</h1>
        <p class="subtitle">Ayo bermain dan belajar bersama hewan lucu!</p>
        
        <div class="level-buttons">
            <a href={`${base}level1`} class="btn-level btn-level-1" data-astro-prefetch>
                <span class="btn-icon">🔗</span>
                <span class="btn-text">Level 1: Mencocokkan</span>
            </a>
            <a href={`${base}level2`} class="btn-level btn-level-2" data-astro-prefetch>
                <span class="btn-icon">🧺</span>
                <span class="btn-text">Level 2: Mengelompokkan</span>
            </a>
            <a href={`${base}level3`} class="btn-level btn-level-3" data-astro-prefetch>
                <span class="btn-icon">🧭</span>
                <span class="btn-text">Level 3: Labirin Seru</span>
            </a>
        </div>
    </div>
</Layout>

<style>
    .center-content {
        align-items: center;
        justify-content: center;
        text-align: center;
        overflow-y: auto;
        padding-top: 10px;
        padding-bottom: 20px;
    }
    
    /* Hide scrollbar for aesthetics but keep functionality */
    .center-content::-webkit-scrollbar {
        width: 8px;
    }
    .center-content::-webkit-scrollbar-track {
        background: transparent;
    }
    .center-content::-webkit-scrollbar-thumb {
        background: rgba(255, 255, 255, 0.5);
        border-radius: 10px;
    }

    .game-title {
        font-size: clamp(2.5rem, 8vw, 5rem);
        margin-bottom: 10px;
        color: var(--primary-dark);
        animation: bounce 2.5s infinite;
        text-shadow: 4px 4px 0px #FFF, -1px -1px 0 #FFF, 1px -1px 0 #FFF, -1px 1px 0 #FFF, 1px 1px 0 #FFF, 5px 8px 15px rgba(0,0,0,0.15);
        line-height: 1.1;
    }

    .subtitle {
        font-size: clamp(0.9rem, 3vw, 1.6rem);
        font-weight: 700;
        margin-bottom: 3vh;
        color: var(--text-dark);
        background: rgba(255, 255, 255, 0.85);
        padding: 8px 20px;
        border-radius: 30px;
        border: 2px solid white;
        box-shadow: 0 5px 15px rgba(0,0,0,0.08);
        display: inline-block;
        max-width: 90%;
    }

    .level-buttons {
        display: flex;
        flex-direction: column;
        gap: 12px;
        width: 100%;
        max-width: 420px;
        margin: 0 auto;
        padding: 0 15px;
    }

    .btn-level {
        display: flex;
        align-items: center;
        padding: 10px 18px;
        border: 4px solid white;
        border-radius: 35px;
        font-family: 'Fredoka One', cursive;
        font-size: clamp(1rem, 3.5vw, 1.5rem);
        color: white;
        text-decoration: none;
        box-shadow: 0 6px 0 rgba(0,0,0,0.15), 0 10px 20px rgba(0,0,0,0.15);
        text-shadow: 1px 1px 2px rgba(0,0,0,0.2);
        transition: all 0.2s cubic-bezier(0.34, 1.56, 0.64, 1);
        position: relative;
        overflow: hidden;
    }

    .btn-level::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 50%;
        height: 100%;
        background: linear-gradient(to right, rgba(255,255,255,0) 0%, rgba(255,255,255,0.3) 50%, rgba(255,255,255,0) 100%);
        transform: skewX(-25deg);
        animation: shine 3s infinite;
    }

    @keyframes shine {
        0% { left: -100%; }
        20% { left: 200%; }
        100% { left: 200%; }
    }

    .btn-level:hover {
        transform: scale(1.03) translateY(-3px);
        box-shadow: 0 8px 0 rgba(0,0,0,0.15), 0 15px 25px rgba(0,0,0,0.2);
        filter: brightness(1.05);
    }

    .btn-level:active {
        transform: scale(0.98) translateY(6px);
        box-shadow: 0 0 0 rgba(0,0,0,0.15);
        transition: all 0.1s;
    }

    .btn-level-1 { background: var(--grad-lvl1); box-shadow: 0 6px 0 #FF7675, 0 10px 20px rgba(0,0,0,0.15); }
    .btn-level-1:active { box-shadow: 0 0 0 #FF7675; }
    .btn-level-1:hover { box-shadow: 0 8px 0 #FF7675, 0 15px 25px rgba(0,0,0,0.2); }

    .btn-level-2 { background: var(--grad-lvl2); box-shadow: 0 6px 0 #00B894, 0 10px 20px rgba(0,0,0,0.15); color: var(--text-dark); text-shadow: none;}
    .btn-level-2:active { box-shadow: 0 0 0 #00B894; }
    .btn-level-2:hover { box-shadow: 0 8px 0 #00B894, 0 15px 25px rgba(0,0,0,0.2); }

    .btn-level-3 { background: var(--grad-lvl3); box-shadow: 0 6px 0 #F39C12, 0 10px 20px rgba(0,0,0,0.15); color: var(--text-dark); text-shadow: none;}
    .btn-level-3:active { box-shadow: 0 0 0 #F39C12; }
    .btn-level-3:hover { box-shadow: 0 8px 0 #F39C12, 0 15px 25px rgba(0,0,0,0.2); }

    .btn-icon {
        font-size: clamp(1.5rem, 5vw, 2rem);
        margin-right: 12px;
        background: white;
        border-radius: 50%;
        width: clamp(40px, 10vw, 55px);
        height: clamp(40px, 10vw, 55px);
        display: flex;
        justify-content: center;
        align-items: center;
        box-shadow: inset 0 -3px 0 rgba(0,0,0,0.1), 0 3px 8px rgba(0,0,0,0.1);
        flex-shrink: 0;
    }

    /* Small phones */
    @media (max-width: 400px) {
        .level-buttons {
            gap: 10px;
            padding: 0 8px;
        }
        .btn-level {
            padding: 8px 14px;
            border-width: 3px;
            border-radius: 25px;
        }
        .btn-icon {
            margin-right: 10px;
        }
    }

    /* Landscape mobile */
    @media (max-height: 500px) {
        .game-title {
            font-size: clamp(1.8rem, 5vw, 3rem);
            margin-bottom: 5px;
        }
        .subtitle {
            margin-bottom: 8px;
            padding: 4px 16px;
            font-size: clamp(0.8rem, 2vw, 1rem);
        }
        .level-buttons {
            gap: 8px;
        }
        .btn-level {
            padding: 6px 14px;
        }
        .btn-icon {
            width: 35px;
            height: 35px;
            font-size: 1.2rem;
        }
    }
</style>

<script>
    import { speak } from '../utils/audio';

    document.addEventListener('astro:page-load', () => {
        // Play instruction when entering main menu if we navigated back
        if(window.location.pathname === import.meta.env.BASE_URL || window.location.pathname === import.meta.env.BASE_URL.slice(0, -1)) {
            setTimeout(() => {
                // If it's the first load, the layout handles the greeting. 
                // We only speak 'Pilih permainan' if coming back from a level.
            }, 500);
        }
    });
</script>
