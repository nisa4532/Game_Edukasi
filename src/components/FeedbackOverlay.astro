---
// src/components/FeedbackOverlay.astro
---

<div id="feedback-overlay" class="overlay hidden">
    <div class="feedback-box">
        <h1 id="feedback-message">Hore! Kamu Hebat!</h1>
        <div class="stars">⭐ ⭐ ⭐</div>
        <button id="feedback-next-btn" class="btn-primary">Lanjut</button>
    </div>
</div>

<style>
.overlay {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0,0,0,0.4);
    backdrop-filter: blur(8px);
    display: flex;
    justify-content: center;
    align-items: center;
    z-index: 9999;
    opacity: 1;
    transition: opacity 0.3s ease;
    padding: 20px;
}

.overlay.hidden {
    opacity: 0;
    pointer-events: none;
}

.feedback-box {
    background: white;
    padding: clamp(25px, 6vw, 50px);
    border-radius: clamp(20px, 5vw, 40px);
    text-align: center;
    box-shadow: 0 20px 50px rgba(0,0,0,0.3);
    transform: scale(1);
    transition: transform 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
    max-width: 90%;
    width: auto;
}

.feedback-box h1 {
    font-size: clamp(1.3rem, 5vw, 2.5rem);
}

.overlay.hidden .feedback-box {
    transform: scale(0.5);
}

.stars {
    font-size: clamp(2rem, 8vw, 4rem);
    margin: clamp(10px, 3vw, 20px) 0;
    animation: float 3s ease-in-out infinite;
}

/* Landscape mobile */
@media (max-height: 500px) {
    .feedback-box {
        padding: 15px 25px;
    }
    .stars {
        font-size: 2rem;
        margin: 8px 0;
    }
}
</style>

<script>
    import { speak } from '../utils/audio';

    export function showFeedback(isCorrect: boolean, isLevelComplete: boolean = false, nextUrl: string = '/') {
        const overlay = document.getElementById('feedback-overlay');
        const msg = document.getElementById('feedback-message');
        const nextBtn = document.getElementById('feedback-next-btn');
        
        if (!overlay || !msg || !nextBtn) return;

        if (isCorrect) {
            if(isLevelComplete) {
                msg.textContent = 'Hore! Kamu Hebat!';
                msg.style.color = '#4CAF50';
                speak('Hore! Kamu hebat sekali! Permainan selesai!');
                overlay.classList.remove('hidden');
                
                nextBtn.onclick = () => {
                    overlay.classList.add('hidden');
                    window.location.href = nextUrl;
                };
            } else {
                speak('Benar!');
            }
        } else {
            speak('Ayo, coba lagi ya!');
        }
    }

    // Attach to window so individual levels can call it easily without circular imports
    (window as any).showFeedback = showFeedback;
</script>
